# ─── Core ────────────────────────────────────────────────────────────────
# Public URL of the site (used for links in e-mails, canonical URLs, CSRF checks)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Postgres connection string (Neon, Supabase, Render, self-hosted...)
DATABASE_URL=postgres://postgres@localhost:5432/releveo
DATABASE_SSL=false
# 32+ random characters: openssl rand -base64 48
AUTH_SECRET=dev-only-insecure-secret-change-me
# Number of reverse proxies in front of the app (for client IP / rate limiting)
TRUSTED_PROXY_HOPS=1

# ─── Payments: mock | stripe | lemonsqueezy ─────────────────────────────
PAYMENT_PROVIDER=mock
# Only for a public demo/staging running the sandbox provider in production mode
# ALLOW_MOCK_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PACK=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
# STRIPE_AUTOMATIC_TAX=true
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PACK=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_BUSINESS_MONTHLY=
LEMONSQUEEZY_VARIANT_BUSINESS_YEARLY=

# ─── E-mail: console | smtp | resend ────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM="Relevéo <bonjour@releveo.fr>"
EMAIL_REPLY_TO=support@releveo.fr
RESEND_API_KEY=
# smtp://user:pass@smtp.example.com:587
SMTP_URL=
SUPPORT_EMAIL=support@releveo.fr
NEXT_PUBLIC_SUPPORT_EMAIL=support@releveo.fr

# ─── Analytics (first-party events are always on; Plausible is optional) ─
PLAUSIBLE_DOMAIN=
# PLAUSIBLE_HOST=https://plausible.io

# ─── Operations ──────────────────────────────────────────────────────────
# Comma-separated e-mails allowed to open /admin
ADMIN_EMAILS=
# Secret for POST /api/cron/lifecycle (Authorization: Bearer ...)
CRON_SECRET=

# ─── Legal identity (displayed on legal pages; placeholders until set) ──
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_STATUS=
NEXT_PUBLIC_LEGAL_SIREN=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_VAT=
NEXT_PUBLIC_LEGAL_DIRECTOR=
NEXT_PUBLIC_LEGAL_HOST=
